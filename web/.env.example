# Supabase project settings (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Never use the service role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Public origin of this app, used for email confirmation redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: where the browser finds the Beat This! ONNX model manifest (see README, "Beat detection model").
# NEXT_PUBLIC_BEAT_MODEL_MANIFEST_URL=/models/beat_this-final0.json
# Optional: pin the model file's SHA-256 from its manifest.
# NEXT_PUBLIC_BEAT_MODEL_SHA256=
