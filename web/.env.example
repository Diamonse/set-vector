# Supabase project settings (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Never use the service role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Public origin of this app, used for email confirmation redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
